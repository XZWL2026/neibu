<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.xzwl.cloud</groupId>
  <artifactId>xzwl-cloud</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <modules>
    <module>platform/platform-bom</module>
    <module>platform/platform-kernel</module>
    <module>platform/web-error-starter</module>
    <module>platform/feign-context-starter</module>
    <module>platform/messaging-contract-starter</module>
    <module>platform/architecture-rules</module>
    <module>service-template</module>
    <module>gateways/gateway-service</module>
    <module>services/compatibility-smoke-service</module>
    <module>services/iam-service</module>
    <module>services/user-service</module>
    <module>services/access-service</module>
    <module>services/billing-service</module>
    <module>services/payment-service</module>
    <module>services/routing-service</module>
    <module>services/storage-service</module>
    <module>services/media-service</module>
    <module>services/operations-service</module>
    <module>services/promotion-service</module>
    <module>services/canvas-service</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.xzwl.cloud</groupId>
        <artifactId>platform-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
