{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xzwlab.local/contracts/protocol-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "contractVersion",
    "source",
    "globalProtocol",
    "evidence",
    "assertions",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "xzwlab-api" },
    "contractVersion": { "const": "1.3.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "openapiPath", "openapiSha256"],
      "properties": {
        "commit": { "const": "d1f9c5afec8aa13d30b153d055c96a24e4c69cf2" },
        "openapiPath": { "const": "docs/openapi.json" },
        "openapiSha256": { "const": "781e7796e6083a317f6f7f87a24fc58ede7b201b9f74739b7fcf61bb757869d7" }
      }
    },
    "globalProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionPrefixes",
        "requestId",
        "authenticationMechanisms",
        "errorEnvelope",
        "requestNaming",
        "responseNaming"
      ],
      "properties": {
        "versionPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "requestId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestHeader", "responseHeader", "evidenceRefs"],
          "properties": {
            "requestHeader": { "type": ["string", "null"], "minLength": 1 },
            "responseHeader": { "type": ["string", "null"], "minLength": 1 },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          }
        },
        "authenticationMechanisms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "locations", "evidenceRefs"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "locations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["in", "name", "scheme"],
                  "properties": {
                    "in": { "enum": ["header", "cookie", "query"] },
                    "name": { "$ref": "#/$defs/nonEmptyString" },
                    "scheme": { "type": ["string", "null"], "minLength": 1 }
                  }
                }
              },
              "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
            }
          }
        },
        "errorEnvelope": { "$ref": "#/$defs/protocolShape" },
        "requestNaming": { "$ref": "#/$defs/namingRule" },
        "responseNaming": { "$ref": "#/$defs/namingRule" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourcePath",
          "blobObjectId",
          "contentSha256",
          "locatorType",
          "locator"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "blobObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "locatorType": { "enum": ["export", "test", "route", "hook", "schema"] },
          "locator": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "operations": {
      "type": "array",
      "minItems": 207,
      "maxItems": 207,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "protocolShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaLocators", "evidenceRefs"],
      "properties": {
        "schemaLocators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "namingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "evidenceRefs"],
      "properties": {
        "style": { "enum": ["identity", "camelCase", "snake_case"] },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "headerRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "evidenceRefs"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "valueRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "operand"],
      "properties": {
        "operator": { "enum": ["equals", "one-of", "matches", "present", "absent", "type"] },
        "operand": true
      }
    },
    "responseHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "valueRule", "evidenceRefs"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "valueRule": { "$ref": "#/$defs/valueRule" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "statusOrNull": {
      "type": ["integer", "null"],
      "minimum": 100,
      "maximum": 599
    },
    "authAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allOfMechanismIds", "anyOfRoles", "allOfRoles", "predicates", "evidenceRefs"],
      "properties": {
        "allOfMechanismIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "anyOfRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allOfRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "predicates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanismIds",
        "alternatives",
        "requiredHeaders",
        "unauthenticatedStatus",
        "forbiddenStatus",
        "evidenceRefs"
      ],
      "properties": {
        "mechanismIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/authAlternative" }
        },
        "requiredHeaders": {
          "type": "array",
          "items": { "$ref": "#/$defs/headerRequirement" }
        },
        "unauthenticatedStatus": { "$ref": "#/$defs/statusOrNull" },
        "forbiddenStatus": { "$ref": "#/$defs/statusOrNull" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterLocations",
        "contentTypes",
        "requiredFields",
        "schemaLocators",
        "evidenceRefs"
      ],
      "properties": {
        "parameterLocations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["path", "query", "header", "cookie", "body"] }
        },
        "contentTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "requiredFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "schemaLocators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "wireRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "selector", "valueRule", "evidenceRefs"],
      "properties": {
        "location": { "enum": ["header", "body"] },
        "selector": { "$ref": "#/$defs/nonEmptyString" },
        "valueRule": { "$ref": "#/$defs/valueRule" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contentTypes", "headers", "schemaLocators", "wireRules", "evidenceRefs"],
      "properties": {
        "status": {
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "const": "default" }
          ]
        },
        "contentTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/responseHeader" }
        },
        "schemaLocators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "wireRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/wireRule" }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "pathParameterMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalName", "variantName"],
      "properties": {
        "canonicalName": { "$ref": "#/$defs/nonEmptyString" },
        "variantName": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "assertionRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operationId",
        "variant",
        "runner",
        "caseRole",
        "fixturePath",
        "caseName",
        "claimPointer",
        "projection",
        "comparison",
        "coverage",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "operationId": { "type": ["string", "null"], "minLength": 1 },
        "variant": { "enum": ["global", "canonical", "legacy"] },
        "runner": { "enum": ["runtime-inject", "route-schema", "source-ast"] },
        "caseRole": { "enum": ["claim-proof", "auth-positive", "auth-negative", "response-trigger", "clock-canary"] },
        "fixturePath": {
          "type": "string",
          "pattern": "^contracts/protocol/legacy-xzwlab/fixtures/.+\\.json$"
        },
        "caseName": { "$ref": "#/$defs/nonEmptyString" },
        "claimPointer": { "type": "string", "pattern": "^/" },
        "projection": { "enum": ["identity-v1", "sorted-set-v1", "path-map-v1", "global-protocol-v1", "auth-contract-v1", "request-contract-v1", "response-contract-v1"] },
        "comparison": { "enum": ["exact-json", "set-equal", "matches-rule"] },
        "coverage": { "enum": ["atomic", "exhaustive"] },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "pathParameterMap",
        "auth",
        "request",
        "responses",
        "responseNaming",
        "evidenceRefs",
        "assertionRefs",
        "resolution",
        "gapReason"
      ],
      "properties": {
        "kind": { "enum": ["canonical", "legacy"] },
        "path": { "type": "string", "pattern": "^/" },
        "pathParameterMap": {
          "type": "array",
          "items": { "$ref": "#/$defs/pathParameterMap" }
        },
        "auth": { "$ref": "#/$defs/auth" },
        "request": { "$ref": "#/$defs/request" },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/response" }
        },
        "responseNaming": { "$ref": "#/$defs/namingRule" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "assertionRefs": { "$ref": "#/$defs/assertionRefs" },
        "resolution": { "enum": ["resolved", "gap"] },
        "gapReason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "resolution": { "const": "gap" } } },
          "then": { "properties": { "gapReason": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "gapReason": { "type": "null" } } }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "method",
        "path",
        "legacyPaths",
        "contractLevel",
        "variants"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/nonEmptyString" },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
        "path": { "type": "string", "pattern": "^/" },
        "legacyPaths": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        },
        "contractLevel": { "enum": ["baseline", "strict"] },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
