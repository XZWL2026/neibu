  "narrative": {
    "northStar": "YOMIO Operational Map",
    "overview": "YOMIO is a restrained workspace for extended daily administration. A navy navigation spine keeps the operational map stable while pale working surfaces organize dense records, totals and deliberate commands. Indigo connects actions and selection across directories, detail drawers and configuration forms.\n\nThe system is code-led and data-first. Joined ledger bands and continuous filter-to-record surfaces create hierarchy through grouping rather than ornament. Naive UI supplies interactive primitives, Lucide supplies consistent outline icons, and ECharts supplies genuine chart rendering. Loading, unknown, empty and failure states keep their business meaning.",
    "keyCharacteristics": [
      "Navy navigation, cool workspace, white working surfaces and indigo commands.",
      "Joined totals and continuous filter-to-record containers.",
      "Compact Chinese interface typography with tabular operational numbers.",
      "Grouped navigation, focused drawers and local mobile table scrolling.",
      "Accessible control states and honest data states."
    ],
    "rules": [
      {
        "name": "The One Command Color Rule",
        "body": "Use shared indigo for commands and selection; preserve status colors for their actual meaning.",
        "section": "colors"
      },
      {
        "name": "The Legible Number Rule",
        "body": "Use tabular numerals for operational values; preserve exact meaning when values wrap.",
        "section": "typography"
      },
      {
        "name": "The Stable Workspace Rule",
        "body": "Keep identity and grouped navigation steady while records and filters adapt inside the content column.",
        "section": "layout"
      },
      {
        "name": "The Flat Working Surface Rule",
        "body": "Use boundaries and tonal grouping for working panels; reserve lifted depth for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reuse the navy rail, indigo commands, shared title scale and flat white working surfaces.",
      "**Do** join related totals and keep filters with their records.",
      "**Do** preserve visible focus, accessible names and textual status alongside color.",
      "**Do** keep mobile overflow local and use drawer navigation.",
      "**Do** use Lucide outline icons and the intentional interface font stack.",
      "**Do** preserve unknown, loading, empty and retry states and server-confirmed business authority."
    ],
    "donts": [
      "**Don't** reintroduce the superseded bright-blue command palette from lazy legacy declarations.",
      "**Don't** add title eyebrows, decorative metric icons or glyph substitutes for icons.",
      "**Don't** add working-panel shadows or imagery that competes with records.",
      "**Don't** use the provider code face for ordinary interface headings or labels.",
      "**Don't** turn unknown amounts into zero or use plotted numbers for financial operations."
    ]
  }
