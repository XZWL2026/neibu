      "css": ".ds-field-label{display:grid;gap:7px;color:var(--muted,#657187);font:11px \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;}.ds-input{min-height:38px;max-width:100%;padding:8px 11px;border:1px solid var(--line,#e3e7ee);border-radius:var(--radius-control,7px);color:var(--ink,#202d43);background:#fff;font:13px/1.5 \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;caret-color:var(--accent,#4f46e5);}.ds-input::placeholder{color:#6b7589;opacity:1;}.ds-input:hover:not(:disabled){border-color:#bdc5d2;}.ds-input:focus-visible{outline:2px solid #a5a0ef;outline-offset:1px;border-color:var(--accent,#4f46e5);}.ds-input:disabled,.ds-input[readonly]{background:#f8f9fc;color:var(--muted,#657187);}"
