      "css": ".ds-ledger{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;border:1px solid var(--line,#e3e7ee);border-radius:var(--radius-panel,12px);background:#fff;overflow:hidden;font-family:\"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;}.ds-ledger article{display:grid;align-content:start;min-width:0;min-height:136px;gap:10px;padding:23px 24px;background:#fff;}.ds-ledger article+article{border-left:1px solid var(--line-subtle,#edf0f4);}.ds-ledger h2{margin:0;color:var(--muted,#657187);font-size:12px;font-weight:500;line-height:1.5;}.ds-ledger strong{color:var(--ink,#202d43);font-size:28px;font-weight:650;line-height:1.35;letter-spacing:-.025em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;}.ds-ledger small{color:var(--muted,#657187);font-size:11px;}"
    }
