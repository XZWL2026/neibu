      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Dark map with hover, current and keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"工作区\"><div class=\"ds-nav-label\">工作台</div><a href=\"#overview\" aria-current=\"page\">概览</a><a href=\"#users\">用户管理</a></nav>",
      "css": ".ds-nav{display:grid;gap:3px;padding:14px;background:#182231;font:13px \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;}.ds-nav-label{margin:0 12px 7px;color:#9baac0;font-size:11px;font-weight:500;}.ds-nav a{display:flex;align-items:center;gap:11px;min-height:40px;padding:9px 12px;border-radius:7px;color:#c1ccdc;background:transparent;font-weight:400;text-decoration:none;transition:background-color 150ms,color 150ms;}.ds-nav a:hover{background:#263246;color:#fff;}.ds-nav a[aria-current=page]{background:#37345c;color:#fff;font-weight:550;}.ds-nav a:focus-visible{outline:2px solid #b6afff;outline-offset:-2px;}"
