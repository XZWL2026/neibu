# Empty: same-origin Gateway. Cross-origin: set its HTTP(S) base URL.
VITE_GATEWAY_BASE_URL=
# Login page URL; may be an absolute URL when apps use different origins.
VITE_LOGIN_URL=/admin/login

# Optional local Vite dev proxy to the running Gateway (not exposed to browser code).
# When enabled, keep VITE_GATEWAY_BASE_URL empty for same-origin Cookie/CSRF requests.
ADMIN_GATEWAY_PROXY_TARGET=
# Live administrator preview: https://aiyomio.cn/admin (includes the admin session namespace).
# Log in locally with an online administrator account; changes affect live data.
